# NetGuard IDS Configuration
# Copy this file to .env and adjust values as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Network Capture
NETWORK_INTERFACE=
CAPTURE_FILTER=
PROMISCUOUS_MODE=True

# Detection Thresholds
PORT_SCAN_THRESHOLD=50
PORT_SCAN_TIME_WINDOW=60

DDOS_THRESHOLD=1000
DDOS_TIME_WINDOW=10

BRUTE_FORCE_THRESHOLD=50
BRUTE_FORCE_TIME_WINDOW=300

# ML Model
ML_ANOMALY_THRESHOLD=-0.5

# Database
DATABASE_URL=sqlite:///./netguard.db

# Logging
LOG_LEVEL=INFO

# Email Alerts (Optional)
EMAIL_ALERTS_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
